{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "roast",
  "compatibility_date": "2026-09-21",
  "observability": { "enabled": true },
  "main": "worker.js",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "koffykraft",
      "database_id": "aaa51abd-149b-49ba-a8ae-bfcc5dbe05d1"
    }
  ],
  "env": {
    "production": {
      "vars": {
        "AUTH_EMAIL_ENDPOINT": "https://api.mailgun.net/v3/sandboxb97fe0c72adc4feea556292b5ff5f544.mailgun.org/messages"
      },
      "secrets": [
        "AUTH_EMAIL_SECRET"
      ]
    }
  }
}
